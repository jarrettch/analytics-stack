# Copy to apps/api/.env for local development. Production values live in Render.

# --- Providers ---------------------------------------------------------------
# The Odds API (WNBA odds, scripts/fetch_tennis_odds.py)
ODDS_API_KEY=
# SportsGameOdds (NBA/MLB/NHL/NFL odds and the /api/usage quota page)
SPORTS_GAME_ODDS_KEY=
# SharpAPI (SGO game-line fallback, UFC odds, NFL player props)
SHARP_API_KEY=
# Known boundary for SGO's rolling 30-day usage cycle.
SGO_BILLING_CYCLE_ANCHOR=2026-04-08T00:00:00Z

# --- Supabase ---------------------------------------------------------------
# Odds persistence. If either is unset the routers run without persistence.
SUPABASE_URL=
SUPABASE_KEY=

# --- Cron authentication ----------------------------------------------------
# Shared bearer token for POST /api/{sport}/cron/fetch-odds. These endpoints
# spend provider quota and write to Supabase, so they are the one part of the
# API that must not be publicly callable.
#
# Must be set in BOTH places, to the same value:
#   1. Render (the API reads it)
#   2. The GitHub `production` environment as a secret named CRON_SECRET
#      (all three fetch-*.yml workflows send it)
#
# Auth fails closed: when this is unset the cron routes answer 503 rather than
# accepting unauthenticated requests, so locally they stay off until you set it.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins. Defaults in main.py cover localhost and the
# deployed Vercel/visualize-ev hosts; override to change the set.
# ALLOWED_ORIGINS=http://localhost:3002,https://www.visualize-ev.gg
